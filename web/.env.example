# local: todo funciona en el navegador (ranking solo en este dispositivo).
# firebase: ranking mundial y validación de cada partida en el servidor.
VITE_BACKEND=local

# Solo si VITE_BACKEND=firebase (Consola de Firebase > Configuración del proyecto > Tus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
# Pon true para usar los emuladores locales de Firebase
VITE_FIREBASE_EMULATORS=false
