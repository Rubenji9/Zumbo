# Copia este fichero como web/.env para cambiar cómo arranca `npm run dev`.
# local: todo funciona en el navegador (ranking solo en este dispositivo). Es lo que usa dev por defecto.
# firebase: ranking mundial y validación en el servidor (usa los datos de .env.production).
VITE_BACKEND=local

